{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth/index.js" },
    { "source": "/api/auth", "destination": "/api/auth/index.js" },
    { "source": "/api/customers/(.*)", "destination": "/api/customers/index.js" },
    { "source": "/api/customers", "destination": "/api/customers/index.js" },
    { "source": "/api/loans/(.*)", "destination": "/api/loans/index.js" },
    { "source": "/api/loans", "destination": "/api/loans/index.js" },
    { "source": "/api/payments/(.*)", "destination": "/api/payments/index.js" },
    { "source": "/api/payments", "destination": "/api/payments/index.js" },
    { "source": "/api/reports/(.*)", "destination": "/api/reports/index.js" },
    { "source": "/api/reports", "destination": "/api/reports/index.js" },
    { "source": "/api/credit-risk/(.*)", "destination": "/api/credit-risk/index.js" },
    { "source": "/api/credit-risk", "destination": "/api/credit-risk/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
